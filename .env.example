# Salin ke .env lalu isi. Jangan commit .env.
LIVEKIT_URL=wss://livekit.hizkialb.xyz
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# DB klarfinance (SQL Server), schema: deskcall
DESKCALL_DB_URL=
DESKCALL_DB_USER=
DESKCALL_DB_PASSWORD=

# API key untuk memanggil deskcall-api (header X-API-Key); boleh lebih dari satu, pisah koma
DESKCALL_API_KEYS=

# Opsional
# SERVER_PORT=8090
# DESKCALL_DDL_AUTO=validate   # ganti none kalau validate false-negative di SQL Server
# DESKCALL_SWAGGER_ENABLED=true   # Swagger UI di /swagger-ui.html; default mati, jangan dinyalakan di produksi

# Classifier LLM (opsional; tanpa ini dipakai rule-based). Pilih salah satu (urutan prioritas):
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=            # Google AI Studio (tier gratis)
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_THINKING_LEVEL=     # opsional, mis. minimal
# LLM_BASE_URL=https://api.groq.com/openai/v1   # atau OpenRouter / Ollama lokal (http://localhost:11434/v1)
# LLM_MODEL=
# LLM_API_KEY=
# LLM_REASONING_EFFORT=low   # untuk model penalar (mis. openai/gpt-oss-* di Groq)

# Demo saja: izinkan pembuka tanpa "asisten digital" (discloseAi=false). JANGAN true di produksi.
# DESKCALL_ALLOW_DEMO_OPENING=false

# Mode I/O worker: text (uji lewat chat, default) | voice (suara)
# DESKCALL_IO_MODE=text
# TTS Google Cloud (tier gratis: 1 juta karakter/bulan WaveNet, 4 juta Standard). Key project GCP dengan
# "Cloud Text-to-Speech API" aktif; kosong = pakai GEMINI_API_KEY
# GOOGLE_CLOUD_API_KEY=
# GOOGLE_TTS_VOICE=id-ID-Wavenet-A     # id-ID-Wavenet-A..D, id-ID-Standard-A..D
# GOOGLE_TTS_SPEAKING_RATE=1.0
# STT: groq (Whisper) | google (Cloud Speech-to-Text, 60 menit/bulan gratis). Default groq kalau GROQ_API_KEY ada
# STT_PROVIDER=
# GROQ_API_KEY=
# DESKCALL_VAD_MIN_SILENCE=0.6        # detik hening = akhir ucapan nasabah
